# ---- Telegram MTProto (get api_id & api_hash from https://my.telegram.org) ----
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=your_api_hash
# Paste the session string produced by `npm run login`
TELEGRAM_SESSION=
# Private channel where videos are stored (e.g. @my_video_channel or -1001234567890)
TELEGRAM_CHANNEL=@your_private_channel

# ---- Admin API key (protects upload endpoints) ----
ADMIN_API_KEY=change_this_to_a_long_random_string

# ---- Server ----
PORT=10000
NODE_ENV=production
