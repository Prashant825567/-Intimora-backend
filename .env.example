# Telegram MTProto credentials (from my.telegram.org → API tools)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash

# Telegram session string (from `npm run login`)
TELEGRAM_SESSION=your_session_string_here

# 5 Telegram channels:
# 1. Video channel — video documents
# 2. Thumbnail channel — thumbnail photos
# 3. Metadata channel — JSON text messages (video metadata)
# 4. Users channel — JSON text messages (user accounts, names, usernames, referrals)
# 5. Referrals channel — JSON text messages (referral tree — who referred whom)
TELEGRAM_CHANNEL_VIDEO=@your_video_channel
TELEGRAM_CHANNEL_THUMB=@your_thumbnail_channel
TELEGRAM_CHANNEL_META=@your_metadata_channel
TELEGRAM_CHANNEL_USERS=@your_users_channel
TELEGRAM_CHANNEL_REFERRALS=@your_referrals_channel

# Admin API key for admin operations
ADMIN_API_KEY=your_admin_key_here

# Firebase (backend — token verification via REST API, no service account key needed)
# Get API key from Firebase Console → Project Settings → General → Web app
FIREBASE_API_KEY=your_firebase_api_key_here

# Server port (default 10000, Netlify sets this automatically)
PORT=10000

# Node environment
NODE_ENV=production
