# Telegram MTProto credentials (from my.telegram.org → API tools)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash

# Telegram session string (from `npm run login`)
TELEGRAM_SESSION=your_session_string_here

# Telegram channel for video storage (private, e.g. @your_channel)
TELEGRAM_CHANNEL=@your_channel

# Telegram public channel username for CDN streaming (optional)
# Set this to your channel's public username (e.g. "intimora_videos")
# If not set, server streams video directly (slower, uses bandwidth)
# If set, server redirects to Telegram CDN (zero bandwidth, serverless-friendly)
TELEGRAM_CHANNEL_PUBLIC=

# Admin API key for upload/delete operations
ADMIN_API_KEY=your_admin_key_here

# Server port (default 10000, Netlify sets this automatically)
PORT=10000

# Node environment
NODE_ENV=production
