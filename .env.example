# Telegram MTProto credentials (from my.telegram.org → API tools)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash

# Telegram session string (from `npm run login`)
TELEGRAM_SESSION=your_session_string_here

# 3 separate channels:
# 1. Video channel — video documents (must be public for CDN streaming)
# 2. Thumbnail channel — thumbnail photos
# 3. Metadata channel — JSON text messages (title, views, likes, shares, file locations)
TELEGRAM_CHANNEL_VIDEO=@your_video_channel
TELEGRAM_CHANNEL_THUMB=@your_thumbnail_channel
TELEGRAM_CHANNEL_META=@your_metadata_channel

# Video channel's PUBLIC username (without @) for CDN streaming redirect.
# e.g. if TELEGRAM_CHANNEL_VIDEO=@IntimoraVideos, then TELEGRAM_CHANNEL_PUBLIC=IntimoraVideos
# Leave empty to use server streaming instead (slower, uses bandwidth)
TELEGRAM_CHANNEL_PUBLIC=

# Admin API key for upload/delete operations
ADMIN_API_KEY=your_admin_key_here

# Server port (default 10000, Netlify sets this automatically)
PORT=10000

# Node environment
NODE_ENV=production
